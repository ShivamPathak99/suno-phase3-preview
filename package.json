{
  "name": "suno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:all": "npm.cmd run lint && npm.cmd run typecheck && npm.cmd run test:adaptive && npm.cmd run test:reset-demo && npm.cmd run test:guards && npm.cmd run test:analysis && npm.cmd run test:confirmation && npm.cmd run test:golden && npm.cmd run test:worksheets && npm.cmd run test:worksheet-page",
    "risk-spike": "node --env-file=.env.local --import tsx scripts/risk-spike.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "reset-demo": "node --env-file=.env.local --import tsx scripts/reset-demo.ts",
    "setup:storage": "node --env-file=.env.local --import tsx scripts/setup-storage.ts",
    "test:guards": "node --import tsx scripts/test-transcription-guard.ts",
    "test:adaptive": "node --import tsx scripts/test-adaptive-fixtures.ts",
    "test:reset-demo": "node --import tsx scripts/test-reset-demo-contract.ts",
    "verify:guards": "node --env-file=.env.local --import tsx scripts/verify-transcription-guard-live.ts",
    "test:analysis": "node --import tsx scripts/test-analysis-contract.ts",
    "test:confirmation": "node --import tsx scripts/test-confirmation-contract.ts",
    "verify:confirmation": "node --env-file=.env.local --import tsx scripts/verify-confirm-live.ts",
    "verify:analysis": "node --env-file=.env.local --import tsx scripts/verify-analysis-live.ts",
    "test:golden": "node --import tsx scripts/test-golden-harness.ts",
    "golden": "node --env-file=.env.local --import tsx scripts/golden.ts",
    "test:worksheets": "node --import tsx scripts/test-worksheet-contract.ts",
    "verify:worksheets": "node --env-file=.env.local --import tsx scripts/verify-worksheet-live.ts",
    "test:worksheet-page": "node --import tsx scripts/test-worksheet-page-contract.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "next": "^16.2.10",
    "openai": "^6.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
